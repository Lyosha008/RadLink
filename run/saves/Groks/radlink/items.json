[
  {
    "id": "test_food",
    "name": "test_food",
    "maxStackSize": 1,
    "trigger": "eated",
    "item_type": "food",
    "nutrition": 6,
    "saturation": 1.0,
    "eat_duration": 10,
    "then": [
      {
        "say": { "text": "Item used!" }
      }
    ]
  },
  {
    "id": "test_item",
    "name": "test_item",
    "maxStackSize": 1,
    "trigger": "right_click",
    "if": {
      "calc": {
        "expression": "${global_atmosphere} / 2", ">=": 100
      }
    },
    "then": [
      {
        "set": {
          "has_right_arm": 3.0
        }
      },
      {
        "explosion": {
          "radius": 5.0,
          "fire": true
        }
      },
      {
        "run":[
          {
            "command": "title @s title {\"text\":\"Атака!\",\"color\":\"red\"}"
          },
          {
            "command": "give @s minecraft:diamond 1"
          }
        ]
      }
    ]
  },
  {
    "id": "atmosphere_checker",
    "name": "atmosphere_checker",
    "maxStackSize": 1,
    "trigger": "right_click",
    "then": [
      {
        "If": {
          "who": "entity",
          "entity": {
            "==": "player"
          }
        },
        "Then": [
          {
            "effect": {
              "id": "regeneration",
              "duration": 100,
              "amplifier": 1
            }
          },
          {
            "tp": {
              "mode": [
                {
                  "mode_type": "revive_teleport",
                  "coordinates": [
                    500,
                    {
                      "~": "15"
                    },
                    200
                  ],
                  "return_delay_ticks": 60
                }
              ]
            }
          },
          {
            "say": {
              "text": "Atmosphere: ${global_atmosphere}"
            }
          },
          {
            "set": [
              {
                "mode": [
                  {
                    "mode_type": "fill"
                  },
                  {
                    "coordinates_1": [
                      {
                        "~": "-1"
                      },
                      {
                        "~": "-1"
                      },
                      {
                        "~": "-1"
                      }
                    ]
                  },
                  {
                    "coordinates_2": [
                      {
                        "~": "1"
                      },
                      {
                        "~": "-1"
                      },
                      {
                        "~": "1"
                      }
                    ]
                  }
                ],
                "block": "diamond_block",
                "tests": [
                  {
                    "isAir": false,
                    "type": "destroy",
                    "filter": "white_wool"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "test_projectile",
    "name": "test_projectile",
    "maxStackSize": 64,
    "item_type": "projectile",
    "trigger": "right_click",
    "if": {
      "who": "any",
      "any": {
          "==": "was_hit"
      }
    },
    "then": [
      {
        "case": [
          {
            "If": {
              "was_hit": {
                "who": "entity",
                "entity": {
                  "==": [
                    "zombie",
                    "skeleton",
                    "creeper",
                    "spider"
                  ]
                }
              }
            },
            "Then": {
              "damage": 5.0
            }
          },
          {
            "If": {
              "was_hit": {
                "who": "block",
                "block": {
                  "==": "any"
                }
              }
            },
            "Then": {
              "set": [
                {
                  "mode": [
                    { "mode_type": "set_block" },
                    { "coordinates_1": [{"~": "0"}, {"~": "0"}, {"~": "0"}]}
                  ],
                  "block": "air",
                  "harvestLevel": 1,
                  "tests": [
                    { "isAir": false, "type": "destroy", "filter": "no" }
                  ]
                }
              ]
            }
          }
        ]
      }
    ]
  }
]